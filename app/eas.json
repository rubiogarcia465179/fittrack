{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": false,
      "ios": { "resourceClass": "default" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": { "appleId": "REPLACE_WITH_YOUR_APPLE_ID_EMAIL", "ascAppId": "REPLACE_AFTER_CREATING_THE_APP_IN_APP_STORE_CONNECT" },
      "android": { "track": "internal", "serviceAccountKeyPath": "./google-play-service-account.json" }
    }
  }
}
