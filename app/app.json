{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "bundleIdentifier": "nl.fittrack.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "FitTrack uses your photos only if you choose one for your training diary or Home screen. Photos stay on your phone."
      }
    },
    "android": {
      "package": "nl.fittrack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./public/favicon-32.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-file-system",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrack uses your photos only if you choose one for your training diary or Home screen. Photos stay on your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "description": "Your gym workout, simple. Today's plan in one tap, every set in two, real progress. No account, no cloud."
  }
}
