---
/**
 * Detalle de ejercicio (/exercises/[id]/) — SSR: imagen, instrucciones,
 * músculos, material, nivel y fuente.
 */
import Layout from '../../components/Layout.astro';
import exData from '../../data/exercises.json';

const id = Astro.params.id;
const e = exData.exercises.find((x) => x.id === id);
if (!e) notFound();

const source = e.source;

export function getStaticPaths() {
  return exData.exercises.map((x) => ({
    params: { id: x.id },
    props: {},
  }));
}
---

<Layout
  Title={e.name_en + ' — FitTrack'}
  TitleKey="ex_title"
  Active="nav_exercises"
  Description={e.name_en + ' — instrucciones y detalles.'}
>
  <a class="text-[14px] text-AppLink hover:underline" href="/exercises/" data-i18n="back">Volver</a>

  <article class="mt-4">
    <div class="Card overflow-hidden p-0">
      <img src={e.image} alt={e.name_en} class="w-full max-h-[420px] object-cover" />
    </div>

    <div class="mt-6">
      <h1 class="PageTitle">{e.name_en}</h1>
      <p class="mt-1 text-[17px] text-AppSecondary">{e.name_nl}</p>

      <dl class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
        <div class="StatCard">
          <dt class="StatLabel" data-i18n="ex_muscle">Musculación principal</dt>
          <dd class="mt-1 text-[15px] font-semibold" data-i18n={'group_' + e.muscle_group}>{e.muscle_group}</dd>
        </div>
        <div class="StatCard">
          <dt class="StatLabel" data-i18n="ex_equipment">Material</dt>
          <dd class="mt-1 text-[15px] font-semibold" data-i18n={'equip_' + e.equipment}>{e.equipment}</dd>
        </div>
        <div class="StatCard">
          <dt class="StatLabel" data-i18n="ex_level">Nivel</dt>
          <dd class="mt-1 text-[15px] font-semibold" data-i18n={'level_' + e.level}>{e.level}</dd>
        </div>
        <div class="StatCard">
          <dt class="StatLabel" data-i18n="ex_source">Fuente</dt>
          <dd class="mt-1 text-[15px] font-semibold" data-i18n={source === 'seed' ? 'source_seed' : 'source_real'}>
            {source}
          </dd>
        </div>
      </dl>

      {
        e.license ? (
          <p class="mt-3 text-[13px] text-AppDim">
            <span data-i18n="ex_license">Licencia</span>: {e.license}
            {e.credit ? <> · <span data-i18n="ex_credit">Autor</span>: {e.credit}</> : ''}
            {' '}· <a class="text-AppLink hover:underline" href="https://wger.de" target="_blank" rel="noreferrer">wger.de</a>
          </p>
        ) : ''
      }

      {
        e.secondary_muscles && e.secondary_muscles.length > 0 ? (
          <p class="mt-3 text-[14px] text-AppSubtext">
            <span data-i18n="ex_secondary">Músculos secundarios</span>:
            {e.secondary_muscles.map((m, i) => (
              <>
                {i > 0 ? ', ' : ''}
                <span data-i18n={'group_' + m}>{m}</span>
              </>
            ))}
          </p>
        ) : ''
      }

      <section class="mt-8">
        <h2 class="text-[20px] font-semibold tracking-apple" data-i18n="ex_instructions">Ejecución</h2>
        <ol class="mt-4 flex flex-col gap-3">
          {
            e.instructions.map((step, i) => (
              <li class="Card flex gap-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-AppBlue/10 text-[13px] font-semibold text-AppLink">
                  {i + 1}
                </span>
                <p class="text-[15px] pt-1">{step}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="mt-10 flex gap-3">
        <a class="BtnPrimary" href="/session/" data-i18n="nav_session">Sesión</a>
      </div>
    </div>
  </article>
</Layout>
